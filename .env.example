# Optional. Copy to .env to customize the server.
# Codex uses the local Codex CLI login.
# CODEX_BIN=C:/path/to/codex.exe
CODEX_EFFORT_FAST=low
CODEX_EFFORT_STRONG=medium
PORT=8787

# Optional PostgreSQL. Set DATABASE_URL or configure PGHOST, PGUSER, and PGDATABASE.
# DATABASE_URL=postgresql://localhost/aiworld
# RPG_IMPORT_SQLITE=/path/to/old/game.db
# RPG_PUBLIC_ORIGIN=https://aiworld.example.com

# Optional: enables semantic Recall. Portraits use the local Codex CLI login.
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

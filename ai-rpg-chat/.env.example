# Optional. Copy to .env to customize the server.
# Codex uses the local Codex CLI login.
# CODEX_BIN=C:/path/to/codex.exe
CODEX_EFFORT_FAST=low
CODEX_EFFORT_STRONG=medium
PORT=8787

# Optional: enables semantic Recall and AI Portrait generation.
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# PORTRAIT_MODEL=gpt-image-2
